# Copy to deploy/.env and change every value.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Only used on first start, when no user exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
WEB_PORT=18080
# Files are persisted in the Compose file-data volume mounted at /data/files.
FILE_STORAGE_DIR=/data/files
MAX_UPLOAD_MB=50
